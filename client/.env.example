# 🎯 CENTRALIZED CONFIGURATION
# Copy this file to .env and change VITE_HOST_IP to update all URLs
# localhost = local development  
# 192.168.1.48 = network access (replace with your IP)
# your-domain.com = production

VITE_HOST_IP=localhost

# API Configuration
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=Full Stack Blog Platform
VITE_NODE_ENV=development

# WebRTC Configuration
VITE_WEBRTC_STUN_SERVER_1=stun:stun.l.google.com:19302
VITE_WEBRTC_STUN_SERVER_2=stun:stun1.l.google.com:19302
VITE_ENABLE_VIDEO_CALLS=true

# AI Service Integration
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_ENABLE_AI_FEATURES=true